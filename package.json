{
  "name": "merkle-distribution",
  "version": "0.0.3",
  "description": "",
  "repository": {
    "type": "git",
    "url": "git@github.com:1inch/merkle-distribution.git"
  },
  "type": "module",
  "license": "MIT",
  "dependencies": {
    "@1inch/solidity-utils": "6.9.16",
    "@openzeppelin/contracts": "5.4.0",
    "adm-zip": "0.6.1",
    "commander": "15.0.0",
    "dotenv": "18.0.1",
    "ethereumjs-wallet": "1.0.2",
    "keccak256": "1.0.6",
    "merkletreejs": "0.6.0",
    "qr-image": "3.2.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "4.1.0",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "3.0.11",
    "@nomicfoundation/hardhat-ignition": "3.1.8",
    "@nomicfoundation/hardhat-ignition-ethers": "3.1.6",
    "@nomicfoundation/hardhat-keystore": "3.1.0",
    "@nomicfoundation/hardhat-mocha": "3.1.0",
    "@nomicfoundation/hardhat-network-helpers": "3.0.11",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "3.0.7",
    "@nomicfoundation/hardhat-typechain": "3.1.1",
    "@nomicfoundation/hardhat-verify": "3.1.0",
    "@nomicfoundation/ignition-core": "3.1.9",
    "@types/adm-zip": "0.5.8",
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "@types/mock-fs": "4.13.4",
    "@types/node": "^24.1.0",
    "@types/qr-image": "3.2.11",
    "@types/sinon": "22.0.0",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "chai": "6.2.2",
    "eslint": "^9.32.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-promise": "7.3.0",
    "esmock": "2.7.6",
    "ethers": "6.17.0",
    "hardhat": "3.17.0",
    "mocha": "11.8.0",
    "mock-fs": "5.5.0",
    "rimraf": "6.1.3",
    "sinon": "22.1.0",
    "solhint": "6.2.4",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "typescript-eslint": "8.70.1"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rimraf artifacts cache coverage coverage.json dist",
    "coverage": "hardhat test --coverage",
    "qr:create": "tsx ./src/cli/merkle-drop-cli.ts -gqlcz -v",
    "lk:create": "tsx ./src/cli/merkle-drop-cli.ts -glc -v",
    "lk:check": "tsx ./src/cli/merkle-drop-cli.ts -x",
    "lint": "yarn run lint:sol && yarn run lint:ts",
    "lint:fix": "yarn run lint:sol:fix && yarn run lint:ts:fix",
    "lint:ts": "eslint .",
    "lint:ts:fix": "eslint . --fix",
    "lint:sol": "solhint --max-warnings 0 \"contracts/**/*.sol\"",
    "lint:sol:all": "solhint \"contracts/**/*.sol\"",
    "lint:sol:fix": "solhint --max-warnings 0 \"contracts/**/*.sol\" --fix",
    "test": "hardhat test",
    "test:unit": "hardhat test test/unit/**/*.test.ts",
    "test:integration": "hardhat test test/integration/**/*.test.ts",
    "test:e2e": "hardhat test test/e2e/*.test.ts",
    "test:contracts": "hardhat test test/contracts/*.test.ts",
    "test:coverage": "hardhat test --coverage",
    "drop": "hardhat drop --network",
    "verify:contract": "hardhat verify-deployment --network",
    "verify:links": "hardhat verify-links --network",
    "stat": "hardhat stats --network",
    "rescue": "hardhat rescue --network"
  },
  "resolutions": {
    "elliptic": "6.6.1",
    "handlebars": "4.7.9"
  }
}
